# Configuration de Docker Compose (développement). Copier vers .env : cp .env.example .env
# Ne jamais versionner .env. Aucune valeur ci-dessous n'est un secret réel.
POSTGRES_DB=jacigreen
POSTGRES_USER=jacigreen
# Utiliser des caractères sans signification dans une URL (lettres, chiffres, tiret, point).
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-local
DB_PORT=5432
# Générer une valeur aléatoire : python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=remplacer-par-une-longue-valeur-aleatoire
