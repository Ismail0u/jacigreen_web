# --- Frontend JACIGREEN --------------------------------------------------------
# Toutes les variables VITE_* sont PUBLIQUES (incluses dans le code envoyé au navigateur).
# Ne jamais y placer de secret.

# URL publique de l'API vue du navigateur (formulaire de contact).
VITE_API_URL=http://localhost:8000

# URL publique du site : sert aux liens canoniques, Open Graph et au sitemap.
VITE_SITE_URL=http://localhost:5173

# URL de l'API vue du serveur de build / de développement (pas du navigateur).
# En Docker Compose : http://backend:8000. Hors Docker : identique à VITE_API_URL.
API_INTERNAL_URL=http://localhost:8000
