# Utilisation HORS Docker uniquement (avec Docker Compose, voir le .env à la racine).
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=remplacer-par-une-longue-valeur-aleatoire
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://jacigreen:mot-de-passe-local@localhost:5432/jacigreen
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
# Production : 1 derrière le proxy Render (nécessaire à la limitation de débit par IP).
DRF_NUM_PROXIES=0
THROTTLE_ANON_RATE=120/min
THROTTLE_CONTACT_RATE=5/hour
# Cache partagé (ex. redis://...) recommandé en production multi-workers.
CACHE_URL=locmemcache://
# Deploy Hook Vercel appelé à chaque publication de contenu (vide = désactivé).
FRONTEND_DEPLOY_HOOK_URL=
FRONTEND_DEPLOY_HOOK_COOLDOWN_SECONDS=0
LOG_LEVEL=INFO
